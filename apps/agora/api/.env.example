MONGODB_PASS="changeme"
MONGODB_USER="root"
MONGODB_HOST="agora-mongo"
MONGODB_PORT="27017"
MONGODB_NAME="agora"
NODE_ENV="development"

# Sentry error reporting. Leave SENTRY_DSN empty to disable it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Performance data sample rate, from 0.0 to 1.0 (0.1 = 10% of traces). Leave it empty to turn tracing off.
SENTRY_TRACES_SAMPLE_RATE=
