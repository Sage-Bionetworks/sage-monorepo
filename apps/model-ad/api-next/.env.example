SERVER_PORT="3334"
SPRING_DATA_MONGODB_HOST="model-ad-mongo"
SPRING_DATA_MONGODB_PORT="27017"
SPRING_DATA_MONGODB_DATABASE="model-ad"
SPRING_DATA_MONGODB_USERNAME="root"
SPRING_DATA_MONGODB_PASSWORD="changeme"
SPRING_DATA_MONGODB_AUTHENTICATION_DATABASE="admin"

# Environment name (dev, stage, prod)
SPRING_PROFILES_ACTIVE=dev

# Sentry error reporting. Leave SENTRY_DSN empty to disable it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Performance data sample rate, from 0.0 to 1.0 (0.1 = 10% of traces). Leave it empty to turn tracing off.
SENTRY_TRACES_SAMPLE_RATE=
