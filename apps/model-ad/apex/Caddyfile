:80 {
  handle_path /api-docs* {
    reverse_proxy {env.API_DOCS_HOST}:{env.API_DOCS_PORT}
  }

  # Route /api/v2/data-version to the next api, stripping /api
  handle /api/v2/data-version {
   uri strip_prefix /api
   reverse_proxy {env.API_NEXT_HOST}:{env.API_NEXT_PORT}
  }

  # Route /api/v2/comparison-tools to the next api, stripping /api
  handle /api/v2/comparison-tools/* {
   uri strip_prefix /api
   reverse_proxy {env.API_NEXT_HOST}:{env.API_NEXT_PORT}
  }

  # Route /api/v2/proteomics-individual to the next api, stripping /api
  handle /api/v2/proteomics-individual* {
   uri strip_prefix /api
   reverse_proxy {env.API_NEXT_HOST}:{env.API_NEXT_PORT}
  }

  # Route /api/v2/transcriptomics-individual to the next api, stripping /api
  handle /api/v2/transcriptomics-individual* {
   uri strip_prefix /api
   reverse_proxy {env.API_NEXT_HOST}:{env.API_NEXT_PORT}
  }

  # Route /api/v2/search to the next api, stripping /api
  handle /api/v2/search/* {
   uri strip_prefix /api
   reverse_proxy {env.API_NEXT_HOST}:{env.API_NEXT_PORT}
  }

  # Route /api/v2/models/{name} to the next api, stripping /api
  handle /api/v2/models/* {
   uri strip_prefix /api
   reverse_proxy {env.API_NEXT_HOST}:{env.API_NEXT_PORT}
  }

  # Answer the previous API version with 410 Gone. Tabs loaded before v2 still call /api/v1,
  # and an error response is what makes them show their reload overlay.
  handle /api/v1/* {
    respond 410
  }

	# Route all other /api/* requests to the default API service, stripping /api
  handle_path /api/* {
    reverse_proxy {env.API_HOST}:{env.API_PORT}
  }

  handle {
    reverse_proxy {env.APP_HOST}:{env.APP_PORT}
  }
}
